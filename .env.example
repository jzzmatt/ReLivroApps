# --- Public (safe for browser / Vercel "Production" env) ---
# Supabase project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — RLS protects data; never use service role in the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL for metadata, auth redirects, and absolute links
# Local: http://localhost:3000
# Production: https://YOUR_PRODUCTION_DOMAIN (set in Vercel when domain is known)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true on production during closed beta (onboarding banner + noindex)
# NEXT_PUBLIC_BETA=false

# Optional public support inbox (mailto on /ajuda and landing footer)
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Server-only (never NEXT_PUBLIC_; not used at runtime if hero PNG is committed) ---
# Required only to run: npm run generate:hero
# Also optional for POST /api/listings/analyze-condition (seller still chooses the published condition)
# OPENAI_API_KEY=

# Optional model override (default: gpt-image-2)
# OPENAI_IMAGE_MODEL=

# Optional model for listing condition analysis (default: gpt-4o-mini)
# OPENAI_CONDITION_MODEL=

# Web Push (server-only). Both keys are required before /notifications can subscribe.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@your-domain

# Optional path to hero reference image for npm run generate:hero
# HERO_REFERENCE_IMAGE=scripts/reference/reLivroApps-hero-reference.png

# --- Server-only (local demo seed only — NEVER in client / NEXT_PUBLIC_*) ---
# Required for: npm run seed:demo / npm run seed:demo:clear (Phase 9.6-DATA)
# Also required on the server to deliver browser push after a new message
# SUPABASE_SERVICE_ROLE_KEY=

# Demo seed (development/staging only). Also set SEED_DATABASE=true when running seed scripts.
# DEMO_USER_PASSWORD=
# Optional: lock seed to one Supabase project ref (subdomain before .supabase.co)
# SEED_ALLOWED_SUPABASE_REF=
# Optional comma-separated refs to block
# SEED_BLOCKED_SUPABASE_REFS=
# Set SEED_ALLOW_STAGING=true only for a named non-production staging project
# SEED_ALLOW_STAGING=
