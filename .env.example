# --- Public (safe for browser / Vercel "Production" env) ---
# Supabase project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — RLS protects data; never use service role in the client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL for metadata, auth redirects, and absolute links
# Local: http://localhost:3000
# Production: https://YOUR_PRODUCTION_DOMAIN (set in Vercel when domain is known)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never NEXT_PUBLIC_; not used at runtime if hero PNG is committed) ---
# Required only to run: npm run generate:hero
# OPENAI_API_KEY=
# Optional model override (default: gpt-image-2)
# OPENAI_IMAGE_MODEL=

# --- Server-only (document only — NOT required for current ReLivroApps code) ---
# The app uses the anon key with RLS on server routes via @supabase/ssr.
# Add only if you introduce admin scripts or Edge Functions that bypass RLS:
# SUPABASE_SERVICE_ROLE_KEY=
